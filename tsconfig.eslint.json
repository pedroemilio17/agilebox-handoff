{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "tooling/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist", "**/out", "**/coverage", "**/migrations"]
}
