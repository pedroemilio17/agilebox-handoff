{
  "name": "agilebox",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm native:node && vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "native:node": "node scripts/ensure-native.mjs node",
    "native:electron": "node scripts/ensure-native.mjs electron",
    "db:generate": "pnpm --filter @agilebox/infra-sqlite db:generate",
    "db:migrate": "pnpm --filter @agilebox/infra-sqlite db:migrate",
    "db:seed": "pnpm --filter @agilebox/infra-sqlite db:seed",
    "db:reset": "pnpm --filter @agilebox/infra-sqlite db:reset",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.eslint.json",
    "lint": "eslint . --max-warnings 0",
    "dev": "pnpm --filter @agilebox/desktop dev",
    "build": "pnpm --filter @agilebox/desktop build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
